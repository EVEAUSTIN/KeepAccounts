<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>记得记账 · 好好生活，慢慢积累</title>
<style>
:root {
  --bg: #f3f2ee;
  --paper: #fffefa;
  --ink: #353f3a;
  --muted: #7b827c;
  --sage: #7c9184;
  --rose: #b68379;
  --line: #e5e6de;
  --sand: #d8c4aa;
  --blue: #8c9fab;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font: 14px/1.6 "Microsoft YaHei", "Segoe UI", sans-serif;
}
button, input, select, textarea { font: inherit; }
button {
  cursor: pointer;
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink);
  padding: 9px 15px;
  border-radius: 9px;
}
button:hover { filter: brightness(.96); }
button.primary {
  background: var(--sage);
  color: white;
  border-color: var(--sage);
}
button.danger { color: #a65e54; }
input, select, textarea {
  width: 100%;
  border: 1px solid var(--line);
  padding: 10px 12px;
  border-radius: 8px;
  background: var(--paper);
  color: var(--ink);
}
input:focus, select:focus, textarea:focus {
  outline: 2px solid #a9bbac;
}
aside {
  position: fixed;
  width: 220px;
  height: 100vh;
  padding: 36px 22px;
  border-right: 1px solid var(--line);
  background: #e9ece5;
  display: flex;
  flex-direction: column;
}
.brand {
  font-size: 24px;
  letter-spacing: 3px;
  font-weight: 700;
}
.eyebrow {
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--muted);
}
nav {
  margin-top: 48px;
  display: grid;
  gap: 10px;
}
nav button {
  text-align: left;
  background: transparent;
  border: 0;
  padding: 13px 16px;
}
nav button.active {
  background: var(--sage);
  color: white;
}
aside footer {
  margin-top: auto;
  color: var(--muted);
  font-size: 12px;
}
main {
  margin-left: 220px;
  max-width: 1600px;
  padding: 36px 44px;
}
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 30px;
}
h1 {
  font-size: 29px;
  margin: 6px 0;
  font-weight: 500;
}
h2 {
  font-size: 17px;
  font-weight: 500;
  margin: 0 0 20px;
}
h3 {
  font-weight: 500;
  margin: 0 0 8px;
}
.muted, small { color: var(--muted); }
.tools {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}
.tools input, .tools select { width: auto; }
.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 24px;
}
.card, .panel {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 24px;
}
.card .value {
  font-size: 28px;
  letter-spacing: -1px;
  margin-top: 12px;
  overflow-wrap: anywhere;
}
.card:first-child { background: #e1e8df; }
.income { color: #657f71; }
.expense { color: var(--rose); }
.grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 22px;
  margin-bottom: 22px;
}
.grid > * { min-width: 0; }
.panel { margin-bottom: 22px; }
.grid .panel { margin: 0; }
.empty {
  text-align: center;
  padding: 40px 10px;
  color: var(--muted);
}
.barrow {
  display: grid;
  grid-template-columns: 100px 1fr 115px;
  gap: 12px;
  align-items: center;
  margin: 18px 0;
}
.track {
  height: 9px;
  border-radius: 20px;
  background: #eeeee7;
  overflow: hidden;
}
.fill {
  height: 100%;
  border-radius: 20px;
  background: var(--sage);
}
table {
  width: 100%;
  border-collapse: collapse;
  white-space: nowrap;
}
td, th {
  padding: 14px 12px;
  border-bottom: 1px solid var(--line);
  text-align: left;
}
th {
  color: var(--muted);
  font-size: 12px;
  font-weight: 400;
}
td button {
  border: 0;
  background: transparent;
  padding: 3px 8px;
}
.tablewrap { overflow: auto; }
.tag {
  background: #efeee7;
  padding: 3px 9px;
  border-radius: 5px;
  font-size: 12px;
}
.calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 5px;
}
.day {
  min-height: 78px;
  background: #f6f6f1;
  padding: 8px;
  border-radius: 6px;
  font-size: 12px;
  overflow-wrap: anywhere;
}
.day.today { outline: 1px solid var(--sage); }
.day span { display: block; }
.week {
  text-align: center;
  color: var(--muted);
  padding: 8px;
}
.goalgrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.goalgrid .panel { margin: 0; }
.formgrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}
.field {
  display: grid;
  gap: 6px;
}
.wide { grid-column: 1 / -1; }
label {
  font-size: 12px;
  color: var(--muted);
}
dialog {
  border: 0;
  border-radius: 16px;
  padding: 28px;
  width: min(600px, 94vw);
  max-height: 92vh;
  overflow: auto;
  background: var(--paper);
  color: var(--ink);
  box-shadow: 0 20px 100px #263a3333;
}
dialog::backdrop {
  background: #263a3355;
  backdrop-filter: blur(3px);
}
.dialogtop {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}
.dialogtop h2 { margin: 0; }
.actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 24px;
}
.notice {
  padding: 14px 18px;
  background: #e9ede5;
  border-radius: 10px;
  color: #637367;
  margin: 18px 0;
}
.chart {
  height: 220px;
  display: flex;
  align-items: end;
  gap: 12px;
  padding-top: 20px;
}
.monthbar {
  flex: 1;
  text-align: center;
  min-width: 26px;
}
.bars {
  height: 175px;
  display: flex;
  align-items: end;
  justify-content: center;
  gap: 3px;
}
.bars i {
  display: block;
  width: 16px;
  background: var(--sage);
  border-radius: 4px 4px 0 0;
}
.bars i.out { background: var(--rose); }
#toast {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--ink);
  color: white;
  padding: 12px 24px;
  border-radius: 9px;
  z-index: 10;
  display: none;
}
a { color: var(--sage); }
@media (max-width: 1050px) {
  main { padding: 25px; }
  .cards { grid-template-columns: repeat(2, 1fr); }
  .grid { grid-template-columns: 1fr; }
  .goalgrid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 700px) {
  aside {
    position: static;
    width: auto;
    height: auto;
    padding: 18px;
  }
  nav {
    display: flex;
    margin-top: 16px;
    overflow: auto;
    gap: 3px;
  }
  nav button {
    white-space: nowrap;
    padding: 9px;
  }
  aside footer { display: none; }
  main { margin: 0; padding: 20px 14px; }
  header { align-items: flex-start; flex-direction: column; }
  .cards { gap: 10px; }
  .card { padding: 18px; }
  .card .value { font-size: 23px; }
  .goalgrid { grid-template-columns: 1fr; }
  .formgrid { grid-template-columns: 1fr; }
  .wide { grid-column: auto; }
  .day { padding: 4px; font-size: 10px; min-height: 65px; }
  .panel { padding: 18px; }
  .barrow { grid-template-columns: 80px 1fr 90px; gap: 7px; }
}
</style>
</head>
<body>
<aside>
  <div class="eyebrow">A LITTLE, EVERY DAY</div>
  <div class="brand">记得记账<span style="color:var(--sage)"> ·</span></div>
  <div class="muted">好好生活，慢慢积累</div>
  <nav id="nav">
    <button data-page="overview" class="active">◷　收支总览</button>
    <button data-page="records">≡　记账明细</button>
    <button data-page="monthly">▤　月度报告</button>
    <button data-page="annual">▥　年度报告</button>
    <button data-page="goals">◇　梦想储蓄</button>
    <button data-page="settings">⚙　账户与设置</button>
  </nav>
  <footer>
    我的私人账本<br>
    离线使用 · 数据保存在本机浏览器
  </footer>
</aside>

<main>
  <header>
    <div>
      <div class="eyebrow">MY PERSONAL LEDGER</div>
      <h1 id="title">收支总览</h1>
      <div class="muted" id="subtitle">让每一笔收支，都有迹可循。</div>
    </div>
    <div class="tools">
      <input aria-label="选择月份" type="month" id="month">
      <button class="primary" id="add">＋ 记一笔</button>
    </div>
  </header>
  <div id="content"></div>
</main>

<div id="toast" role="status"></div>

<dialog id="entryDialog">
  <form id="entryForm">
    <div class="dialogtop">
      <h2 id="entryTitle">记一笔</h2>
      <button type="button" data-close="entryDialog" aria-label="关闭">×</button>
    </div>
    <input type="hidden" name="id">
    <input type="hidden" name="member" value="自己">
    <div class="formgrid">
      <div class="field">
        <label for="type">收支类型</label>
        <select name="type" id="type">
          <option>支出</option>
          <option>收入</option>
          <option>转账</option>
        </select>
      </div>
      <div class="field">
        <label for="entryAmount">金额（元）</label>
        <input id="entryAmount" name="amount" required type="number"
               min="0.01" max="999999999" step="0.01" placeholder="0.00">
      </div>
      <div class="field">
        <label for="entryDate">日期</label>
        <input id="entryDate" type="date" name="date" required>
      </div>
      <div class="field">
        <label id="accountLabel" for="entryAccount">支付账户</label>
        <select id="entryAccount" name="account"></select>
      </div>
      <div class="field" id="toField" hidden>
        <label for="entryTo">转入账户</label>
        <select id="entryTo" name="to"></select>
      </div>
      <div class="field">
        <label for="entryCategory">分类</label>
        <select id="entryCategory" name="category"></select>
      </div>
      <div class="field" id="subcategoryField">
        <label for="entrySubcategory">子分类</label>
        <select id="entrySubcategory" name="subcategory"></select>
      </div>
      <div class="field">
        <label for="entryDetail">明细说明</label>
        <input id="entryDetail" name="detail" maxlength="100"
               placeholder="例如：午餐 / 生活费">
      </div>
      <div class="field">
        <label for="entryTag">标签</label>
        <input id="entryTag" name="tag" list="tags" maxlength="40"
               placeholder="选择或输入">
        <datalist id="tags">
          <option>生活必要支出</option>
          <option>变动性支出</option>
          <option>浪费后悔</option>
          <option>超棒</option>
        </datalist>
      </div>
      <div class="field wide" id="goalField" hidden>
        <label for="entryGoal">关联储蓄目标（仅转账计入目标进度）</label>
        <select id="entryGoal" name="goal"></select>
      </div>
      <div class="field wide">
        <label for="entryNote">备注</label>
        <textarea id="entryNote" name="note" maxlength="500" rows="2"></textarea>
      </div>
    </div>
    <div class="actions">
      <button type="button" data-close="entryDialog">取消</button>
      <button class="primary">保存记录</button>
    </div>
  </form>
</dialog>

<dialog id="goalDialog">
  <form id="goalForm">
    <div class="dialogtop">
      <h2>储蓄目标</h2>
      <button type="button" data-close="goalDialog">×</button>
    </div>
    <input name="id" type="hidden">
    <div class="formgrid">
      <div class="field wide">
        <label for="goalName">目标名称</label>
        <input id="goalName" name="name" required maxlength="40">
      </div>
      <div class="field">
        <label for="goalTarget">目标金额（元）</label>
        <input id="goalTarget" name="target" required type="number"
               min="0.01" max="999999999" step="0.01">
      </div>
      <div class="field">
        <label for="goalInitial">初始已存（元）</label>
        <input id="goalInitial" name="initial" required value="0"
               type="number" min="0" max="999999999" step="0.01">
      </div>
      <div class="field">
        <label for="goalKind">目标类型</label>
        <select id="goalKind" name="kind">
          <option>旅行计划</option>
          <option>应急储备</option>
          <option>心愿清单</option>
          <option>长期储蓄</option>
        </select>
      </div>
      <div class="field">
        <label for="goalNote">备注</label>
        <input id="goalNote" name="note" maxlength="100">
      </div>
    </div>
    <div class="actions">
      <button type="button" data-close="goalDialog">取消</button>
      <button class="primary">保存目标</button>
    </div>
  </form>
</dialog>

<script>
'use strict';

const SUBCATEGORIES = {
  '收入': {
    '主动收入': ['奖助学金', '兼职'],
    '理财收入': ['理财基金'],
    '被动收入': ['生活费', '劳务费', '红包'],
    '其他收入': ['二手商品', '偶然性收入', '报销费用']
  },
  '支出': {
    '生活基础': [
      '饭卡充值', '外卖', '外出吃饭', '话费',
      '交通出行', '服装鞋袜', '日用品', '水果零食'
    ],
    '品质消费': [
      '会员充值', '化妆品', '休闲娱乐', '旅游',
      '会员', '养生健康', '游戏充值', '美容美发'
    ],
    '自我投资': ['话剧演出', '学习支出', '打印'],
    '财务管理': ['存钱', '利息还款'],
    '人情往来': ['家人红包', '礼物购买', '捐赠', '请客'],
    '健康管理': ['就诊', '药品'],
    '其他支出': ['意外支出', '烂账']
  }
};

const KEY = 'remember-ledger-v1';
const $ = selector => document.querySelector(selector);
const clone = value => structuredClone(value);
const hasOwn = (object, key) => Object.hasOwn(object, key);

const esc = value => String(value ?? '').replace(
  /[&<>"']/g,
  character => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[character]
);

const money = value => '¥ ' + (value / 100).toLocaleString('zh-CN', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2
});

const cents = value => Math.round(Number(value) * 100);

function today() {
  const date = new Date();
  return [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, '0'),
    String(date.getDate()).padStart(2, '0')
  ].join('-');
}

function uid() {
  return crypto.randomUUID
    ? crypto.randomUUID()
    : Date.now().toString(36) + Math.random().toString(36).slice(2);
}

function fresh() {
  return {
    version: 1,
    records: [],
    goals: [],
    accounts: [
      { name: '现金', initial: 0 },
      { name: '银行卡', initial: 0 },
      { name: '微信', initial: 0 },
      { name: '支付宝', initial: 0 }
    ],
    members: ['自己'],
    categories: {
      '支出': Object.keys(SUBCATEGORIES['支出']),
      '收入': Object.keys(SUBCATEGORIES['收入']),
      '转账': ['账户调度', '债务管理', '梦想储蓄']
    },
    subcategories: clone(SUBCATEGORIES),
    budget: 0,
    payday: 10
  };
}

let state = fresh();
let page = 'overview';
let query = '';
let filter = '全部';
let storageBroken = false;
let toastTimer;

try {
  const raw = localStorage.getItem(KEY);
  if (raw) {
    const saved = JSON.parse(raw);
    validate(saved);
    state = saved;
  }
} catch (error) {
  storageBroken = true;
  alert(
    '无法读取本地账本，请检查浏览器存储设置。' +
    '为保护已有数据，当前禁止写入。'
  );
}

// 兼容之前版本，保留已有记录和自定义分类。
state.subcategories = state.subcategories || clone(SUBCATEGORIES);

for (const type of ['收入', '支出']) {
  state.subcategories[type] = state.subcategories[type] || {};

  state.categories[type] = [
    ...new Set([
      ...Object.keys(SUBCATEGORIES[type]),
      ...state.categories[type]
    ])
  ];

  for (const category of state.categories[type]) {
    if (!hasOwn(state.subcategories[type], category)) {
      Object.defineProperty(state.subcategories[type], category, {
        value: [...(
          hasOwn(SUBCATEGORIES[type], category)
            ? SUBCATEGORIES[type][category]
            : []
        )],
        enumerable: true,
        writable: true,
        configurable: true
      });
    }
  }
}

function validate(value) {
  const str = item => typeof item === 'string' && item.length <= 1000;
  const amount = item =>
    Number.isSafeInteger(item) && Math.abs(item) <= 1e14;

  const names = items =>
    Array.isArray(items) &&
    items.length > 0 &&
    items.every(str) &&
    new Set(items).size === items.length;

  const unique = items =>
    new Set(items.map(item => item.id)).size === items.length;

  if (
    !value ||
    value.version !== 1 ||
    !Array.isArray(value.records) ||
    !Array.isArray(value.goals) ||
    !Array.isArray(value.accounts) ||
    !value.accounts.length ||
    !value.accounts.every(account =>
      str(account.name) && amount(account.initial)
    ) ||
    new Set(value.accounts.map(account => account.name)).size !==
      value.accounts.length ||
    !names(value.members) ||
    !['收入', '支出', '转账'].every(type => names(value.categories?.[type])) ||
    !amount(value.budget) ||
    value.budget < 0 ||
    !Number.isInteger(value.payday) ||
    value.payday < 1 ||
    value.payday > 31
  ) {
    throw Error('账本数据结构不正确');
  }

  if (value.subcategories !== undefined) {
    if (
      !value.subcategories ||
      typeof value.subcategories !== 'object' ||
      Array.isArray(value.subcategories)
    ) {
      throw Error('分类数据不正确');
    }

    for (const type of ['收入', '支出']) {
      const groups = value.subcategories[type];

      if (!groups || typeof groups !== 'object' || Array.isArray(groups)) {
        throw Error('分类数据不正确');
      }

      for (const [name, list] of Object.entries(groups)) {
        if (
          !value.categories[type].includes(name) ||
          !Array.isArray(list) ||
          list.some(item =>
            typeof item !== 'string' ||
            !item.trim() ||
            item.length > 30
          ) ||
          new Set(list).size !== list.length
        ) {
          throw Error('子分类数据不正确');
        }
      }
    }
  }

  if (
    !unique(value.records) ||
    !unique(value.goals) ||
    !value.goals.every(goal =>
      str(goal.id) &&
      str(goal.name) &&
      str(goal.kind) &&
      str(goal.note) &&
      amount(goal.target) &&
      goal.target > 0 &&
      amount(goal.initial) &&
      goal.initial >= 0
    )
  ) {
    throw Error('储蓄目标不正确');
  }

  for (const record of value.records) {
    if (
      !str(record.id) ||
      !['支出', '收入', '转账'].includes(record.type) ||
      !amount(record.amount) ||
      record.amount <= 0 ||
      !/^\d{4}-\d{2}-\d{2}$/.test(record.date) ||
      isNaN(Date.parse(record.date)) ||
      new Date(record.date).toISOString().slice(0, 10) !== record.date ||
      !value.accounts.some(account => account.name === record.account) ||
      !value.members.includes(record.member) ||
      !value.categories[record.type].includes(record.category) ||
      !['detail', 'tag', 'note', 'goal', 'to'].every(key => str(record[key])) ||
      (record.subcategory !== undefined && !str(record.subcategory)) ||
      (
        record.type === '转账' &&
        (
          !value.accounts.some(account => account.name === record.to) ||
          record.to === record.account
        )
      ) ||
      (
        record.goal &&
        !value.goals.some(goal => goal.id === record.goal)
      )
    ) {
      throw Error('记账记录不正确');
    }
  }
}

function save(next) {
  if (storageBroken) {
    alert('本地存储读取异常，无法保存。请检查浏览器设置。');
    return false;
  }

  try {
    validate(next);
    localStorage.setItem(KEY, JSON.stringify(next));
    state = next;
    return true;
  } catch (error) {
    alert(
      '保存失败：' + error.message +
      '。原有数据未更改，请检查存储空间。'
    );
    return false;
  }
}

function change(callback) {
  const next = clone(state);
  callback(next);
  return save(next);
}

function toast(message) {
  clearTimeout(toastTimer);
  $('#toast').textContent = message;
  $('#toast').style.display = 'block';
  toastTimer = setTimeout(() => {
    $('#toast').style.display = 'none';
  }, 2600);
}

function options(items, selected) {
  return items.map(item => {
    const value = typeof item === 'string' ? item : item.id;
    const label = typeof item === 'string' ? item : item.name;

    return `<option value="${esc(value)}"${
      value === selected ? ' selected' : ''
    }>${esc(label)}</option>`;
  }).join('');
}

function sum(records, type) {
  return records
    .filter(record => record.type === type)
    .reduce((total, record) => total + record.amount, 0);
}

function monthly() {
  return state.records.filter(record =>
    record.date.startsWith($('#month').value)
  );
}

function balance(account) {
  return state.records.reduce((total, record) => {
    if (record.account === account.name) {
      total += record.type === '收入'
        ? record.amount
        : -record.amount;
    }

    if (record.type === '转账' && record.to === account.name) {
      total += record.amount;
    }

    return total;
  }, account.initial);
}

function goalSaved(goal) {
  return goal.initial + state.records
    .filter(record => record.type === '转账' && record.goal === goal.id)
    .reduce((total, record) => total + record.amount, 0);
}

function stats(records) {
  const income = sum(records, '收入');
  const expense = sum(records, '支出');

  return `
    <div class="cards">
      <div class="card">
        <div class="muted">收支结余</div>
        <div class="value">${money(income - expense)}</div>
        <small>收入 − 支出 · 不含转账</small>
      </div>
      <div class="card">
        <div class="muted">总收入</div>
        <div class="value income">${money(income)}</div>
        <small>每一份努力，都值得记录</small>
      </div>
      <div class="card">
        <div class="muted">总支出</div>
        <div class="value expense">${money(expense)}</div>
        <small>把钱花在在意的事情上</small>
      </div>
      <div class="card">
        <div class="muted">结余率</div>
        <div class="value">${
          income
            ? ((income - expense) / income * 100).toFixed(1) + '%'
            : '—'
        }</div>
        <small>本期共 ${records.length} 笔记录</small>
      </div>
    </div>
  `;
}

function table(records) {
  if (!records.length) {
    return `
      <div class="empty">
        还没有记录。点击「＋ 记一笔」，开始记录生活。
      </div>
    `;
  }

  return `
    <div class="tablewrap">
      <table>
        <thead>
          <tr>
            <th>日期</th>
            <th>分类 / 明细</th>
            <th>账户</th>
            <th>标签 / 备注</th>
            <th>金额</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          ${[...records]
            .sort((a, b) => b.date.localeCompare(a.date))
            .map(record => `
              <tr>
                <td>${esc(record.date)}</td>
                <td>
                  ${esc(record.category)}
                  ${record.subcategory
                    ? ' · ' + esc(record.subcategory)
                    : ''}
                  <br>
                  <small>${esc(record.detail || '—')}</small>
                </td>
                <td>
                  ${esc(record.account)}
                  ${record.type === '转账'
                    ? ' → ' + esc(record.to)
                    : ''}
                </td>
                <td>
                  ${record.tag
                    ? `<span class="tag">${esc(record.tag)}</span>`
                    : ''}
                  <br>
                  <small>${esc(record.note)}</small>
