function renderMonthly(records) {
  const [year, month] = $('#month').value.split('-').map(Number);
  const previous = new Date(year, month - 2, 1);
  const previousPrefix = previous.getFullYear() + '-' +
    String(previous.getMonth() + 1).padStart(2, '0');

  const before = state.records.filter(record =>
    record.date.startsWith(previousPrefix)
  );

  const expense = sum(records, '支出');
  const income = sum(records, '收入');
  const previousExpense = sum(before, '支出');
  const days = new Date(year, month, 0).getDate();

  const activeDays = new Set(
    records
      .filter(record => record.type === '支出')
      .map(record => record.date)
  ).size;

  const grouped = new Map();

  for (const record of records) {
    if (record.type !== '支出') continue;

    const key = record.category + ' / ' +
      (record.subcategory || '未设子分类');

    grouped.set(key, (grouped.get(key) || 0) + record.amount);
  }

  const ranking = [...grouped.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, 8);

  const daily = Array.from({ length: days }, (_, index) =>
    sum(
      records.filter(record => +record.date.slice(8) === index + 1),
      '支出'
    )
  );

  const maximum = Math.max(1, ...daily);

  const comparison = previousExpense
    ? (expense >= previousExpense ? '+' : '') +
      ((expense - previousExpense) / previousExpense * 100).toFixed(1) + '%'
    : '暂无可比数据';

  const summary = records.length
    ? '这个月记录了 ' + records.length + ' 笔收支。' +
      (
        income >= expense
          ? '收支结余为 ' + money(income - expense) + '，继续慢慢积累。'
          : '支出高于收入 ' + money(expense - income) +
            '，下个月可以再调整节奏。'
      )
    : '本月还没有记录，记下第一笔生活开销吧。';

  return `
    ${stats(records)}
    <section class="panel">
      <h2>${year} 年 ${month} 月 · 生活账单</h2>
      <div class="cards">
        <div class="card">
          <span class="muted">支出较上月</span>
          <div class="value">${comparison}</div>
          <small>上月 ${money(previousExpense)}</small>
        </div>
        <div class="card">
          <span class="muted">日均支出</span>
          <div class="value">${money(Math.round(expense / days))}</div>
          <small>按当月 ${days} 个自然日计算</small>
        </div>
        <div class="card">
          <span class="muted">有支出的日子</span>
          <div class="value">${activeDays} 天</div>
          <small>最大单日 ${money(Math.max(...daily))}</small>
        </div>
        <div class="card">
          <span class="muted">预算剩余</span>
          <div class="value">${
            state.budget ? money(state.budget - expense) : '未设置'
          }</div>
          <small>${
            state.budget
              ? expense > state.budget
                ? '本月已超预算'
                : '在自己的节奏里生活'
              : '可到账户与设置中填写'
          }</small>
        </div>
      </div>
      <p class="muted">${summary}</p>
    </section>

    <section class="panel">
      <h2>每日支出趋势</h2>
      <div class="tablewrap">
        <div class="chart" style="min-width:750px;gap:5px">
          ${daily.map((value, index) => `
            <div class="monthbar" style="min-width:18px">
              <div class="bars">
                <i class="out"
                   style="height:${value / maximum * 165}px"
                   title="${index + 1}日 ${money(value)}"></i>
              </div>
              <small>${index + 1}</small>
            </div>
          `).join('')}
        </div>
      </div>
    </section>

    <div class="grid">
      <section class="panel">
        <h2>支出分类占比</h2>
        ${categoryChart(records)}
      </section>
      <section class="panel">
        <h2>子分类支出排行</h2>
        ${
          ranking.length
            ? ranking.map(([name, value]) => `
                <div style="
                  display:flex;
                  justify-content:space-between;
                  gap:12px;
                  padding:14px 0;
                  border-bottom:1px solid var(--line);
                ">
                  <span>${esc(name)}</span>
                  <span class="expense">${money(value)}</span>
                </div>
              `).join('')
            : '<div class="empty">暂无支出记录</div>'
        }
      </section>
    </div>
  `;
}

function renderAnnual() {
  const year = $('#month').value.slice(0, 4);
  const records = state.records.filter(record =>
    record.date.startsWith(year)
  );

  const months = Array.from({ length: 12 }, (_, index) => {
    const items = records.filter(record =>
      +record.date.slice(5, 7) === index + 1
    );

    return {
      income: sum(items, '收入'),
      expense: sum(items, '支出')
    };
  });

  const maximum = Math.max(
    1,
    ...months.flatMap(item => [item.income, item.expense])
  );

  return `
    ${stats(records)}
    <section class="panel">
      <h2>
        ${year} 年 · 收支趋势
        <small>绿色收入 / 陶土色支出</small>
      </h2>
      <div class="tablewrap">
        <div class="chart" style="min-width:550px">
          ${months.map((item, index) => `
            <div class="monthbar">
              <div class="bars">
                <i style="height:${item.income / maximum * 165}px"
                   title="收入 ${money(item.income)}"></i>
                <i class="out"
                   style="height:${item.expense / maximum * 165}px"
                   title="支出 ${money(item.expense)}"></i>
              </div>
              <small>${index + 1}月</small>
            </div>
          `).join('')}
        </div>
      </div>
    </section>
    <div class="grid">
      <section class="panel">
        <h2>年度支出分布</h2>
        ${categoryChart(records)}
      </section>
      <section class="panel">
        <h2>月度收支</h2>
        <div class="tablewrap">
          <table>
            <thead>
              <tr>
                <th>月份</th>
                <th>收入</th>
                <th>支出</th>
                <th>结余</th>
              </tr>
            </thead>
            <tbody>
              ${months.map((item, index) => `
                <tr>
                  <td>${index + 1}月</td>
                  <td class="income">${money(item.income)}</td>
                  <td class="expense">${money(item.expense)}</td>
                  <td>${money(item.income - item.expense)}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  `;
}

