    </div>

    ${categorySettings()}
  `;
}

function render() {
  const titles = {
    overview: '收支总览',
    records: '记账明细',
    monthly: '月度报告',
    annual: '年度报告',
    goals: '梦想储蓄',
    settings: '账户与设置'
  };

  $('#title').textContent = titles[page];

  $('#nav').querySelectorAll('button').forEach(button => {
    button.classList.toggle('active', button.dataset.page === page);
  });

  $('#month').style.display =
    ['goals', 'settings'].includes(page) ? 'none' : '';

  const records = monthly();
  let html = '';

  if (page === 'overview') html = renderOverview(records);
  if (page === 'records') html = renderRecords();
  if (page === 'monthly') html = renderMonthly(records);
  if (page === 'annual') html = renderAnnual();
  if (page === 'goals') html = renderGoals();
  if (page === 'settings') html = renderSettings();

  $('#content').innerHTML = html;
  bindContent();
}

function openEntry(id, goal) {
  const form = $('#entryForm');
  form.reset();

  const record = state.records.find(item => item.id === id);
  form.elements.member.value = '自己';

  for (const key of ['account', 'to']) {
    form.elements[key].innerHTML = options(
      state.accounts.map(account => account.name),
      record?.[key]
    );
  }

  form.elements.goal.innerHTML =
    '<option value="">不关联目标</option>' +
    options(state.goals, record?.goal || goal);

  form.elements.type.value = record?.type || (goal ? '转账' : '支出');
  updateType();

  if (
    record &&
    !Array.from(form.elements.category.options).some(option =>
      option.value === record.category
    )
  ) {
    form.elements.category.add(
      new Option(record.category, record.category)
    );
  }

  form.elements.date.value = today();

  if (record) {
    for (const [key, value] of Object.entries(record)) {
      const field = form.elements.namedItem(key);

      if (field && key !== 'member') {
        field.value = key === 'amount' ? value / 100 : value;
      }
    }
  }

  updateSubcategory(record?.subcategory);
  $('#entryTitle').textContent = record ? '编辑记录' : '记一笔';
  $('#entryDialog').showModal();
}

function updateType() {
  const form = $('#entryForm');
  const type = form.elements.type.value;

  form.elements.category.innerHTML = options(state.categories[type]);
  $('#toField').hidden = type !== '转账';
  $('#goalField').hidden = type !== '转账';

  updateSubcategory();

  $('#accountLabel').textContent =
    type === '转账'
      ? '转出账户'
      : type === '收入' ? '收款账户' : '支付账户';
}

function updateSubcategory(selected) {
  const form = $('#entryForm');
  const type = form.elements.type.value;
  const category = form.elements.category.value;
  const groups = state.subcategories[type] || {};

  $('#subcategoryField').hidden = type === '转账';

  const list = hasOwn(groups, category) ? groups[category] : [];
  form.elements.subcategory.innerHTML = options(list);

  if (selected && !list.includes(selected)) {
    form.elements.subcategory.add(new Option(selected, selected));
  }

  if (selected) {
    form.elements.subcategory.value = selected;
  }

  form.elements.subcategory.required =
    type !== '转账' && list.length > 0;
}

function openGoal(id) {
  const form = $('#goalForm');
  form.reset();

  form.elements.id.value = '';
  form.elements.initial.value = 0;

  const goal = state.goals.find(item => item.id === id);

  if (goal) {
    for (const [key, value] of Object.entries(goal)) {
      const field = form.elements.namedItem(key);

      if (field) {
        field.value = ['target', 'initial'].includes(key)
          ? value / 100
          : value;
      }
    }
  }

  $('#goalDialog').showModal();
}

function download(text, name, type) {
  const url = URL.createObjectURL(new Blob([text], { type }));
  const link = document.createElement('a');

  link.href = url;
  link.download = name;
  document.body.appendChild(link);
  link.click();
  link.remove();

  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function csv() {
  const records = filteredRecords();

  const cell = value => '"' +
    String(value ?? '')
      .replace(/^[=+\-@\t\r]/, "'$&")
      .replace(/"/g, '""') +
    '"';

  const rows = [
    [
      '日期', '类型', '分类', '子分类', '明细',
      '账户', '转入账户', '金额（元）', '标签', '目标', '备注'
    ],
    ...records.map(record => [
      record.date,
      record.type,
      record.category,
      record.subcategory || '',
      record.detail,
      record.account,
      record.to,
      (record.amount / 100).toFixed(2),
      record.tag,
      state.goals.find(goal => goal.id === record.goal)?.name || '',
      record.note
    ])
  ];

  download(
    '\uFEFF' + rows.map(row => row.map(cell).join(',')).join('\r\n'),
    '记账明细-' + $('#month').value + '.csv',
    'text/csv;charset=utf-8'
  );
}

function addClassification(type, parent, name) {
  name = name.trim();

  if (!['收入', '支出'].includes(type) || !name || name.length > 30) {
    throw Error('请输入 1–30 字的分类名称');
  }

  if (parent === null) {
    if (state.categories[type].includes(name)) {
      throw Error('该一级分类已存在');
    }

    return change(next => {
      next.categories[type].push(name);

      Object.defineProperty(next.subcategories[type], name, {
        value: [],
        enumerable: true,
        writable: true,
        configurable: true
      });
    });
  }

  if (!state.categories[type].includes(parent)) {
    throw Error('请选择所属一级分类');
  }

  const list = hasOwn(state.subcategories[type], parent)
    ? state.subcategories[type][parent]
    : [];

  if (list.includes(name)) {
    throw Error('该一级分类下已有同名子分类');
  }

  return change(next => {
    next.subcategories[type][parent].push(name);
  });
}

function bindCategorySettings() {
  const categoryForm = $('#addCategoryForm');
  const subcategoryForm = $('#addSubcategoryForm');

  if (!categoryForm || !subcategoryForm) return;

  categoryForm.addEventListener('submit', event => {
    event.preventDefault();
    const data = new FormData(categoryForm);

    try {
      if (addClassification(data.get('type'), null, data.get('name'))) {
        render();
        toast('一级分类已添加');
      }
    } catch (error) {
      alert(error.message);
    }
  });

  $('#subType').addEventListener('change', event => {
    $('#subParent').innerHTML = options(
      state.categories[event.target.value]
    );
  });

  subcategoryForm.addEventListener('submit', event => {
    event.preventDefault();
    const data = new FormData(subcategoryForm);

    try {
      if (
        addClassification(
          data.get('type'),
          data.get('parent'),
          data.get('name')
        )
      ) {
        render();
        toast('子分类已添加');
      }
    } catch (error) {
      alert(error.message);
    }
  });
}

function bindContent() {
  function on(selector, event, callback) {
    const element = $(selector);
    if (element) element.addEventListener(event, callback);
  }

  on('#filter', 'change', event => {
    filter = event.target.value;
    render();
  });

  on('#search', 'input', event => {
    const position = event.target.selectionStart;
    query = event.target.value;
    render();
    $('#search').focus();
    $('#search').setSelectionRange(position, position);
  });

  on('#csv', 'click', csv);
  on('#newGoal', 'click', () => openGoal());

  on('#preferences', 'submit', event => {
    event.preventDefault();
    const data = new FormData(event.target);

    if (change(next => {
      next.budget = cents(data.get('budget'));
      next.payday = Number(data.get('payday'));
    })) {
      render();
      toast('设置已保存');
    }
  });

  bindCategorySettings();
}

$('#content').addEventListener('click', event => {
  const button = event.target.closest('button');
  if (!button) return;

  const data = button.dataset;

  if (data.edit) {
    openEntry(data.edit);
  }

  if (
    data.delete &&
    confirm('确定删除这笔记录？账户余额和储蓄进度将同步更新。')
  ) {
    if (change(next => {
      next.records = next.records.filter(record =>
        record.id !== data.delete
      );
    })) {
      render();
    }
  }

  if (data.goalEdit) {
    openGoal(data.goalEdit);
  }

  if (data.goalSave) {
    openEntry(null, data.goalSave);
  }

  if (data.goalDelete) {
    if (state.records.some(record => record.goal === data.goalDelete)) {
      alert('该目标有关联记录，请先编辑这些记录，解除关联后再删除。');
      return;
    }

    if (
      confirm('确定删除此目标？') &&
      change(next => {
        next.goals = next.goals.filter(goal =>
          goal.id !== data.goalDelete
        );
      })
    ) {
      render();
    }
  }

  if (data.account) {
    const account = state.accounts.find(item =>
      item.name === data.account
    );

    const value = prompt(
      '设置期初余额（元，可为负数；当前余额还会叠加所有收支和转账）',
      account.initial / 100
    );

    if (value === null) return;

    if (
      !/^-?\d+(\.\d{1,2})?$/.test(value.trim()) ||
      Math.abs(Number(value)) > 999999999
    ) {
      alert('请输入有效金额，最多两位小数');
      return;
    }

    if (change(next => {
      next.accounts.find(item =>
        item.name === account.name
      ).initial = cents(value);
    })) {
      render();
    }
  }
});

$('#entryForm').addEventListener('submit', event => {
  event.preventDefault();

  const record = Object.fromEntries(new FormData(event.target));
  record.id = record.id || uid();
  record.member = '自己';
  record.amount = cents(record.amount);

  if (record.type !== '转账') {
    record.to = '';
    record.goal = '';
  } else {
    record.subcategory = '';

    if (record.to === record.account) {
      alert('转出和转入账户不能相同');
      return;
    }
  }

  if (change(next => {
    const index = next.records.findIndex(item =>
      item.id === record.id
    );

    if (index < 0) {
      next.records.push(record);
    } else {
      next.records[index] = record;
    }
  })) {
    $('#entryDialog').close();
    render();
    toast('已保存，生活又清晰了一点');
  }
});

$('#goalForm').addEventListener('submit', event => {
  event.preventDefault();

  const goal = Object.fromEntries(new FormData(event.target));
  goal.name = goal.name.trim();

  if (!goal.name) {
    alert('请填写目标名称');
    return;
  }

  goal.id = goal.id || uid();
  goal.target = cents(goal.target);
  goal.initial = cents(goal.initial);

  if (change(next => {
    const index = next.goals.findIndex(item => item.id === goal.id);

    if (index < 0) {
      next.goals.push(goal);
    } else {
      next.goals[index] = goal;
    }
  })) {
    $('#goalDialog').close();
    render();
    toast('目标已保存');
  }
});

$('#type').addEventListener('change', updateType);

$('#entryForm').elements.category.addEventListener('change', () => {
  updateSubcategory();
});

document.querySelectorAll('[data-close]').forEach(button => {
  button.addEventListener('click', () => {
    $('#' + button.dataset.close).close();
  });
});

$('#nav').addEventListener('click', event => {
  const button = event.target.closest('[data-page]');

  if (button) {
    page = button.dataset.page;
    render();
  }
});

$('#month').value = today().slice(0, 7);

$('#month').addEventListener('change', () => {
  if (!$('#month').value) {
    $('#month').value = today().slice(0, 7);
  }

  render();
});

$('#add').addEventListener('click', () => openEntry());

render();
</script>
</body>
</html>
