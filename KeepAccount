                    ? 'income'
                    : record.type === '支出' ? 'expense' : ''
                }">
                  ${
                    record.type === '收入'
                      ? '+'
                      : record.type === '支出' ? '−' : '⇄'
                  }
                  ${money(record.amount)}
                </td>
                <td>
                  <button data-edit="${esc(record.id)}">编辑</button>
                  <button class="danger"
                          data-delete="${esc(record.id)}">删除</button>
                </td>
              </tr>
            `).join('')}
        </tbody>
      </table>
    </div>
  `;
}

function categoryChart(records) {
  const total = sum(records, '支出');
  const grouped = new Map();

  for (const record of records) {
    if (record.type === '支出') {
      grouped.set(
        record.category,
        (grouped.get(record.category) || 0) + record.amount
      );
    }
  }

  const entries = [...grouped.entries()].sort((a, b) => b[1] - a[1]);
  const colors = ['#7c9184', '#b8a598', '#8c9fab', '#b68379', '#aaa58d'];

  if (!entries.length) {
    return '<div class="empty">暂无支出，留一点空间给生活。</div>';
  }

  return entries.map(([category, value], index) => `
    <div class="barrow">
      <span>${esc(category)}</span>
      <div class="track">
        <div class="fill" style="
          width:${value / total * 100}%;
          background:${colors[index % colors.length]};
        "></div>
      </div>
      <span style="text-align:right">
        ${money(value)}<br>
        <small>${(value / total * 100).toFixed(1)}%</small>
      </span>
    </div>
  `).join('');
}

function calendar(records) {
  const [year, month] = $('#month').value.split('-').map(Number);
  const days = new Date(year, month, 0).getDate();
  const offset = new Date(year, month - 1, 1).getDay();

  let html = ['日', '一', '二', '三', '四', '五', '六']
    .map(day => `<div class="week">${day}</div>`)
    .join('');

  html += '<div></div>'.repeat(offset);

  for (let day = 1; day <= days; day++) {
    const date = [
      year,
      String(month).padStart(2, '0'),
      String(day).padStart(2, '0')
    ].join('-');

    const items = records.filter(record => record.date === date);
    const income = sum(items, '收入');
    const expense = sum(items, '支出');

    html += `
      <div class="day ${date === today() ? 'today' : ''}">
        ${day}
        ${income
          ? `<span class="income">+${money(income)}</span>`
          : ''}
        ${expense
          ? `<span class="expense">−${money(expense)}</span>`
          : ''}
      </div>
    `;
  }

  return `<div class="calendar">${html}</div>`;
}

function renderOverview(records) {
  const spent = sum(records, '支出');
  const budget = state.budget;
  const now = new Date();
  now.setHours(0, 0, 0, 0);

  function allowanceDate(year, month) {
    return new Date(
      year,
      month,
      Math.min(state.payday, new Date(year, month + 1, 0).getDate())
    );
  }

  let nextDate = allowanceDate(now.getFullYear(), now.getMonth());

  if (nextDate < now) {
    nextDate = allowanceDate(now.getFullYear(), now.getMonth() + 1);
  }

  const days = Math.round((nextDate - now) / 86400000);

  return `
    ${stats(records)}
    <div class="tools" style="margin-bottom:18px">
      <span class="muted">距离下次发生活费还有 ${days} 天</span>
    </div>
    <div class="grid">
      <section class="panel">
        <h2>钱花在哪里 <small> / 支出分类</small></h2>
        ${categoryChart(records)}
      </section>
      <section class="panel">
        <h2>本月预算</h2>
        <div style="font-size:30px;margin:24px 0">
          ${budget ? money(budget - spent) : '尚未设置'}
          <small style="font-size:13px">${budget ? '剩余可用' : ''}</small>
        </div>
        <div class="track">
          <div class="fill" style="
            width:${budget ? Math.min(100, spent / budget * 100) : 0}%;
            background:${budget && spent > budget
              ? 'var(--rose)'
              : 'var(--sage)'};
          "></div>
        </div>
        <p class="muted">${
          budget
            ? `已用 ${money(spent)} / 预算 ${money(budget)}`
            : '在「账户与设置」中，为每个月设定一个温柔的边界。'
        }</p>
        <small>预算适用于每个月，按你的全部支出计算。</small>
      </section>
    </div>
    <section class="panel">
      <h2>收支日历</h2>
      ${calendar(records)}
    </section>
    <section class="panel">
      <h2>最近记录</h2>
      ${table(
        [...records]
          .sort((a, b) => b.date.localeCompare(a.date))
          .slice(0, 6)
      )}
    </section>
  `;
}

function filteredRecords() {
  return monthly().filter(record => {
    const matchesType = filter === '全部' || record.type === filter;
    const searchable = [
      record.detail,
      record.note,
      record.category,
      record.subcategory || '',
      record.account,
      record.tag
    ].join(' ').toLowerCase();

    return matchesType && searchable.includes(query.toLowerCase());
  });
}

function renderRecords() {
  const records = filteredRecords();

  return `
